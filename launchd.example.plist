<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 자정에 열려 있는 세션도 SessionEnd 와 똑같이 기록한다. 세션 자체는 종료하지 않는다.
       StartCalendarInterval 은 그 시각에 잠들어 있으면 건너뛰지 않고 **깨어날 때 실행**한다.
       그때도 네트워크가 없으면 요약이 실패하는데, 실패 시 증분 마커를 전진시키지 않으므로
       다음 자정 실행이 같은 구간을 다시 요약한다(별도 재시도 스케줄이 필요 없다).
       ⚠️ launchd 는 ~ 를 확장하지 않는다. 경로는 반드시 절대경로로 쓸 것. -->
  <key>Label</key>
  <string>com.claude-obsidian-logger.catchup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/absolute/path/to/claude-obsidian-logger/hooks/session_log.py</string>
    <string>--catchup</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>0</integer>
    <key>Minute</key><integer>7</integer>
  </dict>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd 는 최소 환경으로 돈다. claude CLI 가 있는 디렉토리를 PATH 에 넣어야 한다. -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>OBSIDIAN_VAULT</key>
    <string>/absolute/path/to/your/Obsidian</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/claude-obsidian-logger.catchup.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/claude-obsidian-logger.catchup.err</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
